# Environment variables for KasirKita
# Ganti kredensial (user, password, host, port, dbname) sesuai konfigurasi PostgreSQL lokal Anda.

# Koneksi Aplikasi (Neon Pooled Connection untuk Vercel / Lokal)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kasirkita?schema=public"

# Koneksi Langsung Migrasi Prisma (Neon Unpooled Direct Connection)
# Di lokal: sama dengan DATABASE_URL. Di Neon: gunakan host unpooled (tanpa -pooler)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kasirkita?schema=public"

# Rahasia sesi JWT untuk autentikasi (Fase 2) - Gunakan string acak minimal 32 karakter di produksi
JWT_SECRET="kasirkita-secret-key-change-in-production-min-32-chars-long"

# Mode environment (development / production)
NODE_ENV="development"

# Konfigurasi Reverse Proxy (BNSP Unit 5: Keamanan Informasi)
# Set "true" jika di balik reverse proxy terpercaya (Vercel / Cloudflare / Nginx).
# Biarkan "false" pada instalasi lokal langsung untuk proteksi anti-spoofing IP.
TRUST_PROXY="false"

# Demo Fast-Fill Login Buttons (Opsional)
# Set "true" jika ingin menampilkan tombol isi cepat login demo pada deployment staging publik
ENABLE_DEMO_FAST_FILL="false"
